; Every regression runs through with-built-plugin.sh, which points findlib at
; this tree's freshly built plug-in rather than the copy installed in the opam
; switch, and turns on the AST integrity check. (package ast_utils) is the
; dependency that makes dune populate the install lib it points at.

(rule
 (alias runtest)
 (deps (source_tree regressions) (package ast_utils))
 (action
  (run ./regressions/with-built-plugin.sh
   %{workspace_root}/../install/default/lib ./regressions/run.sh)))

(rule
 (alias runtest)
 (deps (source_tree regressions) (package ast_utils))
 (action
  (run ./regressions/with-built-plugin.sh
   %{workspace_root}/../install/default/lib ./regressions/run_exec_add_funspec.sh)))

(rule
 (alias runtest)
 (deps (source_tree regressions) (package ast_utils))
 (action
  (run ./regressions/with-built-plugin.sh
   %{workspace_root}/../install/default/lib ./regressions/run_funspec_scope.sh)))

(rule
