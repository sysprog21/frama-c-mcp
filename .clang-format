BasedOnStyle: Chromium
Language: Cpp
MaxEmptyLinesToKeep: 3
IndentCaseLabels: false
AllowShortIfStatementsOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: false
AllowShortLoopsOnASingleLine: false
DerivePointerAlignment: false
PointerAlignment: Right
SpaceAfterCStyleCast: true
TabWidth: 4
UseTab: Never
IndentWidth: 4
BreakBeforeBraces: Linux

# ACSL lives in comments here, and it is code rather than prose. Reflowing
# it merged "loop assigns" and "loop variant" onto the tail of a wrapped
# invariant in five tutorial fixtures, which still parses and is unreadable.
ReflowComments: false
AccessModifierOffset: -4
ForEachMacros:
  - list_for_each_entry
  - list_for_each_entry_safe
  - hlist_for_each_entry
AttributeMacros:
  - UNUSED
  - __ALIGNED
  - PACKED
  - MUST_TAIL
  - FORCE_INLINE
StatementAttributeLikeMacros:
  - IIF
StatementMacros:
  - __UNREACHABLE
